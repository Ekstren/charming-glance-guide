rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 24;
    }
    function validMessage() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName == myProfile().data.name
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 280
        && request.resource.data.createdAt == request.time;
    }
    function dmMember(dmId) {
      return signedIn()
        && exists(/databases/$(database)/documents/dms/$(dmId))
        && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.members;
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'lastActive'])
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'lastActive'])
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActive == request.time;
      allow update: if signedIn() && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastActive'])
        && validName(request.resource.data.name)
        && request.resource.data.lastActive == request.time;
      allow delete: if false;
    }

    match /rooms/lobby/messages/{messageId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 80;
      allow create: if validMessage();
      allow update, delete: if false;
    }

    match /dms/{dmId} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if signedIn() && request.query.limit <= 30
        && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['members', 'names', 'createdAt'])
        && request.resource.data.keys().hasOnly(['members', 'names', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && dmId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]))
        && request.resource.data.names is map
        && request.resource.data.names.keys().hasAll(request.resource.data.members)
        && request.resource.data.names.keys().hasOnly(request.resource.data.members)
        && request.resource.data.names[request.resource.data.members[0]] ==
          get(/databases/$(database)/documents/users/$(request.resource.data.members[0])).data.name
        && request.resource.data.names[request.resource.data.members[1]] ==
          get(/databases/$(database)/documents/users/$(request.resource.data.members[1])).data.name
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow get: if dmMember(dmId);
        allow list: if dmMember(dmId) && request.query.limit <= 80;
        allow create: if dmMember(dmId) && validMessage();
        allow update, delete: if false;
      }
    }

    match /boards/main/strokes/{strokeId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 120;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.kind == 'clear'
            && request.resource.data.keys().hasAll(['kind', 'authorId', 'createdAt'])
            && request.resource.data.keys().hasOnly(['kind', 'authorId', 'createdAt']))
          ||
          (request.resource.data.kind == 'stroke'
            && request.resource.data.keys().hasAll(['kind', 'authorId', 'createdAt', 'color', 'width', 'points'])
            && request.resource.data.keys().hasOnly(['kind', 'authorId', 'createdAt', 'color', 'width', 'points'])
            && request.resource.data.color in ['#f7f3ff', '#f767ad', '#6dd5ed', '#ffd166', '#a2e875', '#ae91ff']
            && request.resource.data.width in [3, 7]
            && request.resource.data.points is string
            && request.resource.data.points.size() <= 1800
            && request.resource.data.points.matches('^(1000|[0-9]{1,3}),(1000|[0-9]{1,3})(;(1000|[0-9]{1,3}),(1000|[0-9]{1,3}))*$'))
        );
      allow update, delete: if false;
    }
  }
}
